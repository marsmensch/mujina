# Apollo III mujina-minerd environment (user-editable).
#
# systemd EnvironmentFile syntax: one KEY=VALUE per line; values with
# special characters must be double-quoted; no `export`; lines starting
# with # or ; are comments. After editing, restart the miner:
#   systemctl restart apollo-iii-mujina

# --- Pool (Stratum v1) -----------------------------------------------------
# mujina-minerd connects straight to a public pool with its own Stratum v1
# client; there is no bitcoin node and no ckpool on this image.
# MUJINA_POOL_URL is required to enable the stratum client; without it the
# daemon runs a dummy job source that produces no real work.
# Default: the same public pool the vendor UI defaults to.
MUJINA_POOL_URL="stratum+tcp://stratum.braiins.com:3333"
# Worker name sent to the pool: <your-bitcoin-address>.<worker-name>.
# REPLACE THIS with your own address before first run.
MUJINA_POOL_USER="REPLACE_WITH_YOUR_BITCOIN_ADDRESS.apollo1"
MUJINA_POOL_PASS="x"

# --- Apollo III board -------------------------------------------------------
# Presence of MUJINA_APOLLO_SERIAL enables the board (empty value falls
# back to /dev/ttyS4). All values below are the daemon defaults, listed
# here for visibility; see `mujina-minerd --help` for the full registry.
MUJINA_APOLLO_SERIAL="/dev/ttyS4"
MUJINA_APOLLO_BAUD_INIT="115200"
MUJINA_APOLLO_BAUD_MINING="921600"
# Hashrate target in TH/s; the DVFS frequency ramp stops at the PLL N for
# this target. 12.1 = full rate (PLL 491, ~6.1 V rail). Lower targets ramp
# early (e.g. 8.0). Full vendor mode presets are a follow-on.
MUJINA_APOLLO_MODE="12.1"
MUJINA_APOLLO_EXPECTED_CHIPS="21"

# --- Daemon -----------------------------------------------------------------
# No CPU hashing on the image (MUJINA_CPUMINER_THREADS intentionally
# unset): the ASIC chain is the only miner.
# No USB boards on this platform; skip USB discovery.
MUJINA_USB_DISABLE="1"
# REST API binds to loopback only by default (no authentication). For LAN
# monitoring, uncomment and set a LAN address:
# MUJINA_API_LISTEN="0.0.0.0:7785"
# Log verbosity: default is info for mujina modules, warn for everything
# else. See `mujina-minerd --help` for MUJINA_LOG / RUST_LOG syntax.
# MUJINA_LOG="info"
